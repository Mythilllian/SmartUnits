{% if not measurement.kind %}
class {{ measurement.unit_type }}(Unit):
    __slots__ = (
        "_to_base_multiplier",
        "_to_base_offset",
        "_from_base_multiplier",
        "_from_base_offset",
    )
    _base_unit: "{{ measurement.unit_type }}"
    _to_base_multiplier: float
    _to_base_offset: float
    _from_base_multiplier: float
    _from_base_offset: float

    def __init__(
        self,
        base_unit: "{{ measurement.unit_type }}",
        to_base_multiplier: float,
        to_base_offset: float,
        from_base_multiplier: float,
        from_base_offset: float,
        name: str,
        symbol: str,
    ) -> None:
        super().__init__(base_unit, name, symbol)
        self._to_base_multiplier = to_base_multiplier
        self._to_base_offset = to_base_offset
        self._from_base_multiplier = from_base_multiplier
        self._from_base_offset = from_base_offset

    @override
    def get_base_unit(self) -> "{{ measurement.unit_type }}":
        return self._base_unit

    @override
    def of(self, magnitude: float):
        return {{ measurement.name }}.of(magnitude, self)

    @override
    def of_base_units(self, magnitude: float):
        return {{ measurement.name }}.of_base_units(magnitude, self)

    @override
    def zero(self):
        return self._zero

    @override
    def one(self):
        return self._one
{% else %}
class {{ measurement.unit_type }}({{ helpers['unit_base'](measurement.name) }}):
    __slots__ = ()

    @override
    def of(self, magnitude: float):
        return {{ measurement.name }}.of(magnitude, self)

    @override
    def of_base_units(self, magnitude: float):
        return {{ measurement.name }}.of_base_units(magnitude, self)
{% endif %}

    @override
    def per(self, other: Unit) -> Unit:
        t = type(other)
{% for other_name, result_name in unit_config.get('per', {}).items() %}
        from .{{ helpers['file_name'](other_name) }} import {{ helpers['mtou'](other_name) }}
        if t is {{ helpers['mtou'](other_name) }}:
            from .{{ helpers['unit_module'](result_name) }} import {{ result_name }}
            {% if helpers['kind'](result_name) %}
            return {{ result_name }}.combine(self, other)
            {% else %}
            return {{ result_name }}.derive(self.base_scale() / other.base_scale(), f"{self.name()} per {other.name()}", f"{self.symbol()}/{other.symbol()}")
            {% endif %}
    {% endfor %}

        return super().per(other)

    def __mul__(self, other: Unit) -> Unit:
        t = type(other)
{% for other_name, result_name in unit_config.get('multiply_methods', {}).items() %}
        from .{{ helpers['file_name'](other_name) }} import {{ helpers['mtou'](other_name) }}
        if t is {{ helpers['mtou'](other_name) }}:
            from .{{ helpers['unit_module'](result_name) }} import {{ result_name }}
            {% if helpers['kind'](result_name) %}
            return {{ result_name }}.combine(self, other)
            {% else %}
            return {{ result_name }}.derive(self.base_scale() * other.base_scale(), f"{self.name()} {other.name()}", f"{self.symbol()}*{other.symbol()}")
            {% endif %}
{% endfor %}

        return super().__mul__(other)
{% if not measurement.kind %}

    @staticmethod
    def derive(to_base_multiplier: float, name: str, symbol: str) -> "{{ measurement.unit_type }}":
        for unit in _UNITS:
            if unit._to_base_offset == 0 and is_close(unit._to_base_multiplier, to_base_multiplier):
                return unit
        return {{ measurement.unit_type }}({{ measurement.units[0].variable }}, to_base_multiplier, 0.0, 1 / to_base_multiplier, 0.0, name, symbol)

    @override
    def convert_from(self, magnitude: float, other_unit: "{{ measurement.unit_type }}") -> float:
        return self.from_base_units(other_unit.to_base_units(magnitude))

    @override
    def convert_to(self, magnitude: float, other_unit: "{{ measurement.unit_type }}") -> float:
        return other_unit.from_base_units(self.to_base_units(magnitude))

    @override
    def conversion_from(self, other_unit: "{{ measurement.unit_type }}") -> UnaryFunction:
        return UnaryFunction(lambda x: self.from_base_units(other_unit.to_base_units(x)))

    @override
    def conversion_to(self, other_unit: "{{ measurement.unit_type }}") -> UnaryFunction:
        return UnaryFunction(lambda x: other_unit.from_base_units(self.to_base_units(x)))

    @override
    def from_base_units(self, value_in_base_units: float) -> float:
        return value_in_base_units * self._from_base_multiplier + self._from_base_offset

    @override
    def to_base_units(self, value_in_native_units: float) -> float:
        return value_in_native_units * self._to_base_multiplier + self._to_base_offset

    @override
    def conversion_from_base_units(self) -> UnaryFunction:
        return UnaryFunction(lambda x: self.from_base_units(x))

    @override
    def conversion_to_base_units(self) -> UnaryFunction:
        return UnaryFunction(lambda x: self.to_base_units(x))
{% endif %}
{% endif %}


{{ helpers['file_name'](measurement.name) }} = {{ measurement.name }}
{{ helpers['file_name'](measurement.unit_type) }} = {{ measurement.unit_type }}
{% if not measurement.kind %}
{% set base_unit = measurement.units[0] %}
{{ base_unit.variable }} = {{ measurement.unit_type }}(None, {{ base_unit.to_base_multiplier }}, {{ base_unit.to_base_offset }}, {{ base_unit.from_base_multiplier }}, {{ base_unit.from_base_offset }}, "{{ base_unit.names[0] }}", "{{ base_unit.symbol }}")
{% for unit in measurement.units[1:] %}
{{ unit.variable }} = {{ measurement.unit_type }}({{ base_unit.variable }}, {{ unit.to_base_multiplier }}, {{ unit.to_base_offset }}, {{ unit.from_base_multiplier }}, {{ unit.from_base_offset }}, "{{ unit.names[0] }}", "{{ unit.symbol }}")
{% endfor %}

_UNITS = ({% for unit in measurement.units %}{{ unit.variable }}, {% endfor %})
{% else %}
{% for unit in measurement.units %}
{% set parts = helpers['unit_parts'](unit) %}
{{ unit.variable }} = {{ measurement.unit_type or helpers['unit_class'](unit) }}({{ parts[0] }}, {{ parts[1] }}, "{{ unit.names[0] }}", "{{ unit.symbol }}"{% if 'conversion_factor' in unit %}, {{ unit.conversion_factor }}{% endif %})
{% endfor %}
{% endif %}

{% if measurement.kind == 'compound' %}
__all__ = [{% for unit in measurement.units %}{% if not loop.first %}, {% endif %}"{{ unit.variable }}"{% endfor %}]
{% else %}
__all__ = ["{{ measurement.name }}", "{{ measurement.unit_type }}"{% for unit in measurement.units %}, "{{ unit.variable }}"{% endfor %}]
{% endif %}